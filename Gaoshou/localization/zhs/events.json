  "GAOSHOU_EVENT_GRAND_LIBRARY.pages.INITIAL.options.DONATE.description": "移除1张牌，并获得1个随机遗物。",
  "GAOSHOU_EVENT_GRAND_LIBRARY.pages.INITIAL.options.LEAVE.title": "走了！",
