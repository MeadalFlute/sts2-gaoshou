{
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "Oh? Well now. All that gear on you—where'd you come from?",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.ancient": "I've plenty of old things here. Come on, take one with you.",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.char": "Thanks.",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "Back again, old friend. You're looking well.",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "Have you eaten? — that's how you greet someone here, isn't it?",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "I have.",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.next": "Continue",
  "DARV.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2.ancient": "Good. Rest when you're tired.",

  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "[sine]...you're... awake... good...[/sine]",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.char": "I'm not dead... what is this...?",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.ancient": "[sine]...go... up... the tower...[/sine]",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "[sine]...higher... again...[/sine]",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.char": "Damnit...",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Continue",
  "NEOW.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.ancient": "[sine]..receive.... this.... ..blessing.. ...go......[/sine]",

  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "A wanderer! From outside!? Outside where? How from outside?",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.ancient": "So many weapons!? Amazing!! So fun!!",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.char": "Just passing through.",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.next": "Continue",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-3.ancient": "Fighting is bad!! Don't fight!",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "New weapons!? So cool!!",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "The Architect's not bad! Maybe talk? Talking is good!! Really good!",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "Mm... depends.",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.next": "Continue",
  "OROBAS.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2.ancient": "No violence! Take something shiny... shiny!!",

  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "[thinky_dots]So many weapons... and wound so tight...[/thinky_dots]",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.ancient": "[thinky_dots]Take a piece of my flesh. Sit through this quiet, then go...[/thinky_dots]",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.char": "Thanks.",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "[thinky_dots]Back again... don't make noise... let me sleep...[/thinky_dots]",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "[thinky_dots]Ever dream of being at ease? ...Sleep...[/thinky_dots]",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "Once.",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.next": "Continue",
  "PAEL.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2.ancient": "[thinky_dots]Take some and go... don't rush...[/thinky_dots]",

  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "[b]So many weapons!? Strong! Strong!![/b]",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.char": "Habit.",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.ancient": "[b]Good!! Take this! You can never have too many weapons!![/b]",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "[b]Get stronger!! So we can have a proper fight!!![/b]",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "[b]Warrior, fight me!![/b]",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "Come.",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.next": "Continue",
  "TANX.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2.ancient": "[b]Hah!! A mighty fight! Take a weapon!![/b]",

  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "Oh my, a rare visitor. Empty-handed, yet such a bearing.",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.ancient": "Come, let me see your flame. Burn away the flaws—perhaps you'll shine brighter.",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.char": "No need. I don't use fire.",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.next": "Continue",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-3.ancient": "Oh? A patient one. I like you more and more~",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "Back again? Let me stoke your flame a little brighter.",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "Welcome back. Look at you—flattened so much in silence.",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "Alright.",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.next": "Continue",
  "TEZCATARA.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2.ancient": "Heh... good, good.",

  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "Another mortal to reach this place. Give yourself to me, and you'll be feared as I am.",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.char": "Not interested.",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.ancient": "Don't refuse so fast. Look at this contract—so many beg for it.",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "Changed your mind? My offer only opens once.",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "Always so stubborn. The world rewards stubbornness with no good end.",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "Shut up.",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.next": "Continue",
  "VAKUU.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2.ancient": "Ha, quite the temper. Cling to that stubbornness, then—and endure.",

  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.ancient": "Ah, a guest from afar. Such composed bearing—a rare thing.",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.ancient": "Let me bestow a blessing upon you. That attire suits your air well.",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.char": "Thanks.",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.next": "Continue",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-3.ancient": "No ceremony needed. May your road lie smooth.",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "The guest returns. Come—let me add a touch more luster to your attire.",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.ancient": "You again. Dust-covered, still so composed... I find I take more and more to you.",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0.next": "Respond",
  "NONUPEIPE.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1.char": "Kind of you.",

  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.char": "Is this the top? You there—how do I get back?",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-0.next": "Continue",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.ancient": "Another mortal.",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-1.next": "Continue",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.char": "My patience is limited.",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-2.next": "Continue",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-3.ancient": "There's nothing here for you.",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-startattack": "None",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.0-attack": "Both",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.ancient": "Again? Annoying.",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-0r.next": "Respond",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-1r.char": "Answer me!",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-1r.next": "Continue",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-2r.ancient": "You can't go back. Get lost.",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-startattack": "None",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.1-attack": "Both",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0r.ancient": "[jitter]You again![/jitter]",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-0r.next": "Respond",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1r.char": "We meet again.",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-1r.next": "Continue",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-2r.ancient": "[jitter]Scram![/jitter]",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-startattack": "None",
  "THE_ARCHITECT.talk.GAOSHOU_CHARACTER_GAOSHOU_CHARACTER.2-attack": "Both"
}
