<Project>
  <PropertyGroup>
    <Sts2Dir>E:\SteamLibrary\steamapps\common\Slay the Spire 2</Sts2Dir>
    <!-- 仅在未指定时才用本机默认值：允许命令行 -p:Sts2DataDir 或上级 Directory.Build.props 覆盖。 -->
    <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Dir)\data_sts2_windows_x86_64</Sts2DataDir>
    <GodotExe>D:\Program\Godot\Godot_v4.5.1-stable_mono_win64_console.exe</GodotExe>
    <RitsuLibDeployDir>$(Sts2Dir)\mods\STS2-RitsuLib</RitsuLibDeployDir>
  </PropertyGroup>
</Project>
